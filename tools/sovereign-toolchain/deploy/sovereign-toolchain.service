[Unit]
Description=Sovereign Universal Toolchain Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sovereign-legacy-mcp/sovereign-toolchain
EnvironmentFile=/etc/sovereign-toolchain/runtime.env
Environment=PYTHONPATH=/opt/sovereign-legacy-mcp/sovereign-toolchain/src:/opt/sovereign-legacy-mcp/sovereign-legacy-mcp-common
LoadCredential=github-app-private-key.pem:/opt/secure/sovereign-github-app/private-key.pem
ExecStart=/opt/sovereign-legacy-mcp/sovereign-toolchain/.venv/bin/python -m uvicorn sovereign_toolchain.app:app --host 127.0.0.1 --port 8001 --workers 2
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/sovereign-legacy-mcp

[Install]
WantedBy=multi-user.target
