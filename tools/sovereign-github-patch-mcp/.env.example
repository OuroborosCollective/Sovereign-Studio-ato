# Required: GitHub App metadata for short-lived installation tokens.
# Do not set GITHUB_TOKEN, GH_TOKEN, or a PAT in this file or service unit.
# The private key is delivered by systemd as a read-only credential and the
# adapter mints one repository-scoped token per GitHub API operation.
SOVEREIGN_MCP_GITHUB_APP_ID=
SOVEREIGN_MCP_GITHUB_APP_INSTALLATION_ID=
SOVEREIGN_MCP_REPOSITORY=OuroborosCollective/Sovereign-Studio-ato
SOVEREIGN_MCP_GITHUB_APP_PRIVATE_KEY_FILE=/run/credentials/sovereign-mcp.service/github-app-private-key.pem

# Required for write tools. Comma-separated allowlist.
# Write tools refuse to run until this is set.
ALLOWED_REPOS=OuroborosCollective/Sovereign-Studio-ato

# Optional
GITHUB_API_URL=https://api.github.com
USER_AGENT=sovereign-github-patch-mcp/1.0
MAX_READ_BYTES=200000
MAX_WRITE_BYTES=1000000

# The provided OpenAPI endpoint is exposed as MCP tool apply_patch.
SOVEREIGN_PATCH_URL=https://sovereign-studio-worker.projectouroboroscollective.workers.dev/git/patch

# Optional if your worker expects a bearer secret.
SOVEREIGN_PATCH_BEARER=

# Local server
HOST=0.0.0.0
PORT=8000
