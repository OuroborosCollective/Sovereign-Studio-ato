#!/usr/bin/env bash
set -Eeuo pipefail

DIGEST="${1:-}"
EXPECTED_REVISION="${2:-}"
IMAGE_REPOSITORY="${SOVEREIGN_BACKEND_IMAGE_REPOSITORY:-}"
MANAGED_ENV_FILE="${SOVEREIGN_BACKEND_MANAGED_ENV_FILE:-/opt/sovereign-chatgpt-tools/runtime.env}"

# Resolve backend env file from managed runtime.env, then fall back to canonical paths
# This matches the logic in install-on-vps.sh (lines 1273-1281)
MANAGED_RUNTIME_ENV="${SOVEREIGN_MCP_RUNTIME_ENV:-/opt/sovereign-chatgpt-tools/runtime.env}"
ALLOWED_BACKEND_ENV_PATHS=(
  "/run/secrets/sovereign-backend.env"
  "/opt/sovereign-backend/.env"
)
ALLOWED_BACKEND_MANAGED_ENV_PATHS=(
  "/opt/sovereign-chatgpt-tools/runtime.env"
  "/opt/sovereign-chatgpt-tools/backend-runtime.env"
)

# Try to read from managed runtime.env first
resolve_backend_env_from_managed() {
  if [[ -f "$MANAGED_RUNTIME_ENV" ]]; then
    local env_path
    env_path=$(grep -E '^SOVEREIGN_BACKEND_ENV_FILE=' "$MANAGED_RUNTIME_ENV" 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'")
    if [[ -n "$env_path" && -f "$env_path" ]]; then
      # Validate the resolved path is one of the allowed paths
      for allowed in "${ALLOWED_BACKEND_ENV_PATHS[@]}"; do
        if [[ "$env_path" == "$allowed" ]]; then
          echo "$env_path"
          return 0
        fi
      done
      # Path is not in allowlist - reject arbitrary paths
      return 1
    fi
  fi
  return 1
}

# Fall back to canonical paths (same logic as install-on-vps.sh)
resolve_backend_env_fallback() {
  for candidate in "${ALLOWED_BACKEND_ENV_PATHS[@]}"; do
    if [[ -f "$candidate" ]]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

ENV_FILE=""

CONTAINER="sovereign-backend"
CANDIDATE="sovereign-backend-candidate"
LEGACY_PREDECESSOR="${CONTAINER}-unverified-predecessor"
PREVIOUS_IMAGE=""
PREVIOUS_REPO_DIGEST=""
PREVIOUS_DIGEST=""
PREVIOUS_REVISION=""
PREVIOUS_CONTAINER_ID=""
PREVIOUS_CONTAINER_ID_SHA256=""
PREVIOUS_LOCAL_IMAGE_ID=""
PREVIOUS_IDENTITY_VERIFIED=false
LEGACY_PREDECESSOR_PRESERVED=false
LEGACY_PREDECESSOR_RENAMED_BACK=false
LEGACY_PREDECESSOR_PRESTOP_HEALTH_VERIFIED=false
NEW_IMAGE=""
ADMIN_CANARY=""
RUNTIME_EVIDENCE_ROOT="/opt/sovereign-chatgpt-tools/runtime-evidence"
ROLLBACK_RECEIPT_FILE="${SOVEREIGN_BACKEND_ROLLBACK_RECEIPT_FILE:-$RUNTIME_EVIDENCE_ROOT/backend-rollback-receipt.json}"
ROLLBACK_RECEIPT_DIR=""
OWNER_INPUT_HOST_ROOT="/opt/sovereign-owner-managed"
OWNER_INPUT_CONTAINER_ROOT="/opt/sovereign-owner-managed"
WORKSPACE_HOST_ROOT="/opt/sovereign-agent-workspaces"
WORKSPACE_CONTAINER_ROOT="/var/lib/sovereign-agent/workspaces"
WORKSPACE_UID="10001"
WORKSPACE_GID="10001"
BROKER_SOCKET="${SOVEREIGN_MCP_BROKER_SOCKET:-/run/sovereign-chatgpt-broker/operator.sock}"
BROKER_RUNTIME_DIR="$(dirname "$BROKER_SOCKET")"
BROKER_GID=""
# The Docker provider selects the container IP from this shared bridge. It is
# intentionally separate from sovereign-private, which only carries backend
# dependencies such as PostgreSQL and direct FreeLLM/OpenRouter transports.
TRAEFIK_DOCKER_NETWORK="${SOVEREIGN_TRAEFIK_DOCKER_NETWORK:-traefik-public}"
COMPOSE_TEMPLATE="${SOVEREIGN_BACKEND_COMPOSE_TEMPLATE:-/opt/sovereign-chatgpt-tools/templates/sovereign-backend/docker-compose.yml}"
COMPOSE_PROJECT_DIR="/opt/sovereign-backend"
COMPOSE_FILE="$COMPOSE_PROJECT_DIR/docker-compose.yml"
COMPOSE_RUNTIME_ENV="$COMPOSE_PROJECT_DIR/compose-runtime.env"
STAGE="preflight"

on_error() {
  local exit_code="$?"
  printf 'SOVEREIGN_DEPLOY_DIAGNOSTIC:%s:CommandFailure\n' "$STAGE" >&2
  exit "$exit_code"
}

fail() {
  printf 'SOVEREIGN_DEPLOY_DIAGNOSTIC:%s:ContractFailure\n' "$STAGE" >&2
  printf 'deploy blocked: %s\n' "$*" >&2
  exit 1
}

trap on_error ERR

[[ "$DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]] || fail "invalid image digest"
[[ "$EXPECTED_REVISION" =~ ^[0-9a-f]{40}$ ]] || fail "invalid expected revision"
[[ -n "$IMAGE_REPOSITORY" ]] || fail "SOVEREIGN_BACKEND_IMAGE_REPOSITORY is missing"
[[ "$TRAEFIK_DOCKER_NETWORK" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ ]] \
  || fail "Traefik Docker network name is invalid"

# Resolve the backend env only after the input identity contract is valid. This keeps
# host state from masking malformed digest/revision evidence during preflight.
if [[ -n "${SOVEREIGN_BACKEND_ENV_FILE:-}" ]]; then
  for allowed in "${ALLOWED_BACKEND_ENV_PATHS[@]}"; do
    if [[ "$SOVEREIGN_BACKEND_ENV_FILE" == "$allowed" ]]; then
      ENV_FILE="$SOVEREIGN_BACKEND_ENV_FILE"
      break
    fi
  done
  [[ -n "$ENV_FILE" ]] \
    || fail "SOVEREIGN_BACKEND_ENV_FILE must be one of: ${ALLOWED_BACKEND_ENV_PATHS[*]}"
else
  ENV_FILE="$(resolve_backend_env_from_managed)" || true
  if [[ -z "$ENV_FILE" ]]; then
    ENV_FILE="$(resolve_backend_env_fallback)" || true
  fi
fi

[[ -n "$ENV_FILE" && -f "$ENV_FILE" ]] || fail "backend env file is missing"
MANAGED_ENV_ALLOWED=false
for allowed in "${ALLOWED_BACKEND_MANAGED_ENV_PATHS[@]}"; do
  if [[ "$MANAGED_ENV_FILE" == "$allowed" ]]; then
    MANAGED_ENV_ALLOWED=true
    break
  fi
done
[[ "$MANAGED_ENV_ALLOWED" == "true" && -f "$MANAGED_ENV_FILE" && ! -L "$MANAGED_ENV_FILE" ]] \
  || fail "backend managed env file is missing or outside the allowlist"
unset MANAGED_ENV_ALLOWED allowed
[[ -f "$COMPOSE_TEMPLATE" && ! -L "$COMPOSE_TEMPLATE" ]] \
  || fail "backend compose template is missing or invalid"
docker compose version >/dev/null 2>&1 || fail "docker compose plugin is unavailable"
if [[ -e "$COMPOSE_PROJECT_DIR" || -L "$COMPOSE_PROJECT_DIR" ]]; then
  [[ -d "$COMPOSE_PROJECT_DIR" && ! -L "$COMPOSE_PROJECT_DIR" ]] \
    || fail "backend compose project root is invalid"
else
  install -d -m 0750 "$COMPOSE_PROJECT_DIR"
fi
chmod 0750 "$COMPOSE_PROJECT_DIR"
umask 077
ROLLBACK_RECEIPT_DIR="$(dirname "$ROLLBACK_RECEIPT_FILE")"
[[ "$ROLLBACK_RECEIPT_DIR" == "$RUNTIME_EVIDENCE_ROOT" ]] \
  || fail "rollback receipt must remain inside the managed runtime evidence root"
if [[ -e "$ROLLBACK_RECEIPT_DIR" || -L "$ROLLBACK_RECEIPT_DIR" ]]; then
  [[ -d "$ROLLBACK_RECEIPT_DIR" && ! -L "$ROLLBACK_RECEIPT_DIR" ]] \
    || fail "runtime evidence root is not a regular directory"
else
  mkdir -p "$ROLLBACK_RECEIPT_DIR"
fi
chmod 0700 "$ROLLBACK_RECEIPT_DIR"
[[ -w "$ROLLBACK_RECEIPT_DIR" && -x "$ROLLBACK_RECEIPT_DIR" ]] \
  || fail "runtime evidence root is not writable and searchable"
ROLLBACK_RECEIPT_PROBE="$(mktemp "$ROLLBACK_RECEIPT_DIR/.backend-rollback-receipt-probe.XXXXXX")" \
  || fail "runtime evidence root does not permit atomic receipt creation"
printf '{"ok":true,"secretValuesReturned":false}\n' > "$ROLLBACK_RECEIPT_PROBE" \
  || fail "runtime evidence root does not permit receipt writes"
chmod 0600 "$ROLLBACK_RECEIPT_PROBE"
rm -f "$ROLLBACK_RECEIPT_PROBE"
unset ROLLBACK_RECEIPT_PROBE
if [[ -e "$OWNER_INPUT_HOST_ROOT" || -L "$OWNER_INPUT_HOST_ROOT" ]]; then
  [[ -d "$OWNER_INPUT_HOST_ROOT" && ! -L "$OWNER_INPUT_HOST_ROOT" ]] \
    || fail "owner input host root is not a regular directory"
else
  mkdir -p "$OWNER_INPUT_HOST_ROOT"
fi
[[ -d "$OWNER_INPUT_HOST_ROOT" && ! -L "$OWNER_INPUT_HOST_ROOT" ]] \
  || fail "owner input host root is not a regular directory"
chown root:root "$OWNER_INPUT_HOST_ROOT"
chmod 0700 "$OWNER_INPUT_HOST_ROOT"
[[ "$(stat -c '%u:%g:%a' "$OWNER_INPUT_HOST_ROOT")" == "0:0:700" ]] \
  || fail "owner input host root must be root:root with mode 0700"
[[ -w "$OWNER_INPUT_HOST_ROOT" && -x "$OWNER_INPUT_HOST_ROOT" ]] \
  || fail "owner input host root is not writable and searchable"
if [[ -e "$WORKSPACE_HOST_ROOT" || -L "$WORKSPACE_HOST_ROOT" ]]; then
  [[ -d "$WORKSPACE_HOST_ROOT" && ! -L "$WORKSPACE_HOST_ROOT" ]] \
    || fail "workspace host root is not a regular directory"
else
  mkdir -p "$WORKSPACE_HOST_ROOT"
fi
chown "$WORKSPACE_UID:$WORKSPACE_GID" "$WORKSPACE_HOST_ROOT"
chmod 0770 "$WORKSPACE_HOST_ROOT"
[[ -w "$WORKSPACE_HOST_ROOT" && -x "$WORKSPACE_HOST_ROOT" ]] \
  || fail "workspace host root is not writable and searchable"
[[ -S "$BROKER_SOCKET" ]] || fail "authoritative MCP broker socket is missing"
BROKER_GID="$(stat -c '%g' "$BROKER_SOCKET")"
[[ "$BROKER_GID" =~ ^[0-9]+$ ]] || fail "authoritative MCP broker group could not be resolved"

NEW_IMAGE="${IMAGE_REPOSITORY}@${DIGEST}"
STAGE="image_pull"
docker pull "$NEW_IMAGE" >/dev/null

STAGE="image_digest"
ACTUAL_DIGEST="$(docker image inspect --format '{{index .RepoDigests 0}}' "$NEW_IMAGE" 2>/dev/null || true)"
[[ "$ACTUAL_DIGEST" == *"@$DIGEST" ]] || fail "pulled image digest does not match"

STAGE="image_revision"
IMAGE_REVISION="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$NEW_IMAGE" 2>/dev/null || true)"
[[ "$IMAGE_REVISION" == "$EXPECTED_REVISION" ]] || fail "image revision label does not match expected commit"

STAGE="network_preflight"
# Traefik reads Docker labels but can only route to a container IP on a shared
# Docker bridge. Production and rollback therefore require the configured
# Traefik bridge as well as Sovereign's private dependency bridge.
for network in supabase_default areloria_arelorian-network sovereign-private "$TRAEFIK_DOCKER_NETWORK"; do
  docker network inspect "$network" >/dev/null 2>&1 || fail "required docker network missing: $network"
done

STAGE="candidate_start"
docker rm -f "$CANDIDATE" >/dev/null 2>&1 || true
docker run -d \
  --name "$CANDIDATE" \
  --env-file "$ENV_FILE" \
  --env-file "$MANAGED_ENV_FILE" \
  --env "SOVEREIGN_IMAGE_DIGEST=$DIGEST" \
  --env "SOVEREIGN_SOURCE_REVISION=$EXPECTED_REVISION" \
  --env "SOVEREIGN_MCP_BROKER_SOCKET=$BROKER_SOCKET" \
  --env "SOVEREIGN_LLM_ROUTE_SCANNER_ENABLED=0" \
  --env "SOVEREIGN_AGENT_WORKSPACE_ROOT=$WORKSPACE_CONTAINER_ROOT" \
  --env "SOVEREIGN_AGENT_WORKSPACE_UID=$WORKSPACE_UID" \
  --env "SOVEREIGN_AGENT_WORKSPACE_GID=$WORKSPACE_GID" \
  --network supabase_default \
  --volume /opt/secure:/opt/secure:ro \
  --volume "$OWNER_INPUT_HOST_ROOT:$OWNER_INPUT_CONTAINER_ROOT:rw" \
  --volume "$WORKSPACE_HOST_ROOT:$WORKSPACE_CONTAINER_ROOT:rw" \
  --volume "$BROKER_RUNTIME_DIR:$BROKER_RUNTIME_DIR:ro" \
  --group-add "$BROKER_GID" \
  --label "org.opencontainers.image.revision=$EXPECTED_REVISION" \
  "$NEW_IMAGE" >/dev/null

STAGE="candidate_network"
docker network connect areloria_arelorian-network "$CANDIDATE"
docker network connect sovereign-private "$CANDIDATE"

wait_for_host_health() {
  local health=""
  local max_attempts="${1:-${SOVEREIGN_BACKEND_HEALTH_ATTEMPTS:-36}}"
  [[ "$max_attempts" =~ ^[1-9][0-9]{0,2}$ ]] || max_attempts=36
  for attempt in $(seq 1 "$max_attempts"); do
    health="$(python3 -c 'import urllib.request; print(urllib.request.urlopen("http://127.0.0.1:8788/health/live", timeout=4).read().decode())' 2>/dev/null || true)"
    if printf '%s' "$health" | grep -q '"ok"[[:space:]]*:[[:space:]]*true'; then
      printf '%s' "$health"
      return 0
    fi
    sleep 5
  done
  printf '%s' "$health"
  return 1
}

restore_preserved_legacy_predecessor() {
  [[ "$LEGACY_PREDECESSOR_PRESERVED" == "true" ]] || return 1
  if [[ "$LEGACY_PREDECESSOR_RENAMED_BACK" != "true" ]]; then
    if ! docker inspect "$LEGACY_PREDECESSOR" >/dev/null 2>&1; then
      return 1
    fi
    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
    if ! docker rename "$LEGACY_PREDECESSOR" "$CONTAINER" >/dev/null; then
      return 1
    fi
    LEGACY_PREDECESSOR_RENAMED_BACK=true
  fi
  if ! docker start "$CONTAINER" >/dev/null; then
    return 1
  fi
  if ! wait_for_host_health >/dev/null; then
    return 1
  fi
  LEGACY_PREDECESSOR_PRESERVED=false
  return 0
}

deploy_cleanup() {
  local exit_code="$?"
  trap - ERR
  set +e
  docker rm -f "$CANDIDATE" >/dev/null 2>&1 || true
  if [[ "$exit_code" -ne 0 && "$LEGACY_PREDECESSOR_PRESERVED" == "true" ]]; then
    if ! restore_preserved_legacy_predecessor; then
      printf 'SOVEREIGN_DEPLOY_DIAGNOSTIC:legacy_predecessor_restore:ContractFailure\n' >&2
    fi
  fi
  exit "$exit_code"
}
trap deploy_cleanup EXIT

STAGE="candidate_health"
HEALTH=""
for attempt in $(seq 1 12); do
  HEALTH="$(docker exec "$CANDIDATE" python3 -c 'import urllib.request; print(urllib.request.urlopen("http://127.0.0.1:8787/health/live", timeout=4).read().decode())' 2>/dev/null || true)"
  if printf '%s' "$HEALTH" | grep -q '"ok"[[:space:]]*:[[:space:]]*true'; then
    break
  fi
  sleep 5
done
printf '%s' "$HEALTH" | grep -q '"ok"[[:space:]]*:[[:space:]]*true' || {
  CANDIDATE_STATE="$(docker inspect --format '{{.State.Status}}|{{.State.ExitCode}}|{{.State.OOMKilled}}' "$CANDIDATE" 2>/dev/null || printf 'unknown|-1|false')"
  CANDIDATE_LOGS="$(docker logs "$CANDIDATE" --tail 300 2>&1 || true)"
  CANDIDATE_STATUS="${CANDIDATE_STATE%%|*}"
  CANDIDATE_REMAINDER="${CANDIDATE_STATE#*|}"
  CANDIDATE_EXIT="${CANDIDATE_REMAINDER%%|*}"
  CANDIDATE_OOM="${CANDIDATE_REMAINDER##*|}"
  [[ "$CANDIDATE_STATUS" =~ ^[a-z]{2,24}$ ]] || CANDIDATE_STATUS="unknown"
  [[ "$CANDIDATE_EXIT" =~ ^-?[0-9]{1,5}$ ]] || CANDIDATE_EXIT="-1"
  [[ "$CANDIDATE_OOM" == "true" || "$CANDIDATE_OOM" == "false" ]] || CANDIDATE_OOM="false"
  CANDIDATE_LAST_MIGRATION="$(printf '%s\n' "$CANDIDATE_LOGS" | sed -n 's/^Applying migration: \([A-Za-z0-9._-]\{1,120\}\)$/\1/p' | tail -n 1)"
  [[ "$CANDIDATE_LAST_MIGRATION" =~ ^[A-Za-z0-9._-]{1,120}$ ]] || CANDIDATE_LAST_MIGRATION="none"
  CANDIDATE_LOGS_SHA256="$(printf '%s' "$CANDIDATE_LOGS" | sha256sum | awk '{print $1}')"
  printf 'SOVEREIGN_DEPLOY_CANDIDATE:status=%s:exit=%s:oom=%s:lastMigration=%s:logsSha256=%s\n' \
    "$CANDIDATE_STATUS" "$CANDIDATE_EXIT" "$CANDIDATE_OOM" \
    "$CANDIDATE_LAST_MIGRATION" "$CANDIDATE_LOGS_SHA256" >&2
  unset CANDIDATE_LOGS CANDIDATE_STATE CANDIDATE_REMAINDER
  fail "candidate health check failed"
}

STAGE="previous_identity"
PREVIOUS_IMAGE="$(docker inspect --format '{{.Config.Image}}' "$CONTAINER" 2>/dev/null || true)"
if [[ -n "$PREVIOUS_IMAGE" ]]; then
  PREVIOUS_CONTAINER_ID="$(docker inspect --format '{{.Id}}' "$CONTAINER" 2>/dev/null || true)"
  PREVIOUS_LOCAL_IMAGE_ID="$(docker inspect --format '{{.Image}}' "$CONTAINER" 2>/dev/null || true)"
  PREVIOUS_RUNNING="$(docker inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null || true)"
  if [[ ! "$PREVIOUS_CONTAINER_ID" =~ ^[0-9a-f]{64}$ ]]; then
    fail "previous backend container has no valid local identity"
  fi
  if [[ ! "$PREVIOUS_LOCAL_IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    fail "previous backend container has no valid local image identity"
  fi
  PREVIOUS_CONTAINER_ID_SHA256="$(printf '%s' "$PREVIOUS_CONTAINER_ID" | sha256sum | awk '{print $1}')"
  PREVIOUS_REPO_DIGEST="$(docker image inspect --format '{{index .RepoDigests 0}}' "$PREVIOUS_IMAGE" 2>/dev/null || true)"
  PREVIOUS_DIGEST="${PREVIOUS_REPO_DIGEST##*@}"
  PREVIOUS_REVISION="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$PREVIOUS_IMAGE" 2>/dev/null || true)"
  if [[ "$PREVIOUS_DIGEST" =~ ^sha256:[0-9a-f]{64}$ && "$PREVIOUS_REVISION" =~ ^[0-9a-f]{40}$ ]]; then
    PREVIOUS_IDENTITY_VERIFIED=true
  else
    if [[ "$PREVIOUS_RUNNING" != "true" ]]; then
      fail "unverified previous backend container is not running"
    fi
    if docker inspect "$LEGACY_PREDECESSOR" >/dev/null 2>&1; then
      fail "legacy predecessor preservation target already exists"
    fi
    LEGACY_PREDECESSOR_HEALTH="$(wait_for_host_health 3 || true)"
    if ! printf '%s' "$LEGACY_PREDECESSOR_HEALTH" | grep -q '"ok"[[:space:]]*:[[:space:]]*true'; then
      fail "unverified previous backend liveness could not be proven"
    fi
    LEGACY_PREDECESSOR_PRESTOP_HEALTH_VERIFIED=true
    unset LEGACY_PREDECESSOR_HEALTH
  fi
fi

STAGE="production_start"
if [[ -n "$PREVIOUS_IMAGE" && "$PREVIOUS_IDENTITY_VERIFIED" != "true" ]]; then
  docker rename "$CONTAINER" "$LEGACY_PREDECESSOR"
  LEGACY_PREDECESSOR_PRESERVED=true
  docker stop --time 30 "$LEGACY_PREDECESSOR" >/dev/null
  LEGACY_PREDECESSOR_STATE="$(docker inspect --format '{{.State.Running}}|{{.Image}}' "$LEGACY_PREDECESSOR" 2>/dev/null || true)"
  if [[ "$LEGACY_PREDECESSOR_STATE" != "false|$PREVIOUS_LOCAL_IMAGE_ID" ]]; then
    fail "legacy predecessor preservation readback failed"
  fi
  unset LEGACY_PREDECESSOR_STATE
else
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
fi

write_backend_compose_runtime() {
  local image="$1"
  local revision="$2"
  local runtime_digest="$3"
  local env_tmp=""
  local compose_tmp=""

  [[ "$image" =~ ^[A-Za-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]] \
    || fail "backend compose image is not immutable"
  [[ "$revision" =~ ^[0-9a-f]{40}$ ]] || fail "backend compose revision is invalid"
  [[ "$runtime_digest" =~ ^sha256:[0-9a-f]{64}$ ]] || fail "backend compose digest is invalid"

  env_tmp="$(mktemp "$COMPOSE_PROJECT_DIR/.compose-runtime.env.XXXXXX")"
  {
    printf 'SOVEREIGN_BACKEND_IMAGE=%s\n' "$image"
    printf 'SOVEREIGN_BACKEND_IMAGE_DIGEST=%s\n' "$runtime_digest"
    printf 'SOVEREIGN_BACKEND_SOURCE_REVISION=%s\n' "$revision"
    printf 'SOVEREIGN_BACKEND_ENV_FILE=%s\n' "$ENV_FILE"
    printf 'SOVEREIGN_BACKEND_MANAGED_ENV_FILE=%s\n' "$MANAGED_ENV_FILE"
    printf 'SOVEREIGN_MCP_BROKER_GID=%s\n' "$BROKER_GID"
    printf 'SOVEREIGN_TRAEFIK_DOCKER_NETWORK=%s\n' "$TRAEFIK_DOCKER_NETWORK"
  } > "$env_tmp"
  chmod 0600 "$env_tmp"
  mv -f "$env_tmp" "$COMPOSE_RUNTIME_ENV"

  compose_tmp="$(mktemp "$COMPOSE_PROJECT_DIR/.docker-compose.yml.XXXXXX")"
  install -m 0640 "$COMPOSE_TEMPLATE" "$compose_tmp"
  mv -f "$compose_tmp" "$COMPOSE_FILE"
}

compose_backend() {
  env \
    -u SOVEREIGN_BACKEND_IMAGE \
    -u SOVEREIGN_BACKEND_IMAGE_DIGEST \
    -u SOVEREIGN_BACKEND_SOURCE_REVISION \
    -u SOVEREIGN_BACKEND_ENV_FILE \
    -u SOVEREIGN_BACKEND_MANAGED_ENV_FILE \
    -u SOVEREIGN_MCP_BROKER_GID \
    -u SOVEREIGN_TRAEFIK_DOCKER_NETWORK \
    docker compose \
      --project-name sovereign-backend \
      --project-directory "$COMPOSE_PROJECT_DIR" \
      --env-file "$COMPOSE_RUNTIME_ENV" \
      --file "$COMPOSE_FILE" \
      "$@"
}

start_production() {
  local image="$1"
  local revision="$2"
  local runtime_digest="$3"

  write_backend_compose_runtime "$image" "$revision" "$runtime_digest"
  compose_backend config --quiet
  compose_backend up -d --remove-orphans
}

start_production "$NEW_IMAGE" "$EXPECTED_REVISION" "$DIGEST"

restore_previous() {
  if [[ "$LEGACY_PREDECESSOR_PRESERVED" == "true" ]]; then
    restore_preserved_legacy_predecessor
    return $?
  fi
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  if [[ "$PREVIOUS_IDENTITY_VERIFIED" == "true" ]]; then
    if ! start_production "$PREVIOUS_IMAGE" "$PREVIOUS_REVISION" "$PREVIOUS_DIGEST"; then
      return 1
    fi
    wait_for_host_health >/dev/null
    return $?
  fi
  return 1
}

STAGE="production_health"
HOST_HEALTH="$(wait_for_host_health || true)"
if ! printf '%s' "$HOST_HEALTH" | grep -q '"ok"[[:space:]]*:[[:space:]]*true'; then
  docker logs "$CONTAINER" --tail 150 >&2 || true
  if restore_previous; then
    fail "production health check failed; previous backend restored"
  fi
  fail "production health check failed; previous backend restoration failed"
fi

STAGE="public_ingress_canary"
PUBLIC_OWNER_INGRESS=""
for attempt in $(seq 1 12); do
  PUBLIC_OWNER_INGRESS="$(python3 - <<'PY'
import hashlib
import json
import urllib.request

url = "https://sovereign-backend.arelorian.de/owner-approvals"
try:
    with urllib.request.urlopen(url, timeout=8) as response:
        body = response.read(512_000)
        ok = (
            int(response.status) == 200
            and b"<title>Sovereign Owner-Freigaben</title>" in body
        )
        payload = {
            "ok": ok,
            "status": "PUBLIC_OWNER_INGRESS_VERIFIED" if ok else "PUBLIC_OWNER_INGRESS_CONTRADICTED",
            "httpStatus": int(response.status),
            "responseSha256": hashlib.sha256(body).hexdigest(),
            "markerVerified": b"<title>Sovereign Owner-Freigaben</title>" in body,
            "secretValuesReturned": False,
        }
except Exception as exc:
    payload = {
        "ok": False,
        "status": "PUBLIC_OWNER_INGRESS_UNAVAILABLE",
        "errorType": type(exc).__name__,
        "secretValuesReturned": False,
    }
print(json.dumps(payload, sort_keys=True, separators=(",", ":")))
PY
)"
  if printf '%s' "$PUBLIC_OWNER_INGRESS" | grep -q '"ok":true'; then
    break
  fi
  sleep 5
done
if ! printf '%s' "$PUBLIC_OWNER_INGRESS" | grep -q '"ok":true'; then
  if restore_previous; then
    fail "public Traefik owner-approval ingress check failed; previous backend restored"
