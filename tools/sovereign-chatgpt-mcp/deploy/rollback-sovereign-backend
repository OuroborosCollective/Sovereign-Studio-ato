#!/usr/bin/env bash
set -Eeuo pipefail

DIGEST="${1:-}"
IMAGE_REPOSITORY="${SOVEREIGN_BACKEND_IMAGE_REPOSITORY:-}"
ENV_FILE="${SOVEREIGN_BACKEND_ENV_FILE:-/run/secrets/sovereign-backend.env}"
MANAGED_ENV_FILE="${SOVEREIGN_BACKEND_MANAGED_ENV_FILE:-/opt/sovereign-chatgpt-tools/backend-runtime.env}"
ALLOWED_BACKEND_ENV_PATHS=(
  "/run/secrets/sovereign-backend.env"
  "/opt/sovereign-backend/.env"
)
ALLOWED_BACKEND_MANAGED_ENV_PATHS=(
  "/opt/sovereign-chatgpt-tools/runtime.env"
  "/opt/sovereign-chatgpt-tools/backend-runtime.env"
)
CONTAINER="sovereign-backend"
TARGET_IMAGE=""
OWNER_INPUT_HOST_ROOT="/opt/sovereign-owner-managed"
OWNER_INPUT_CONTAINER_ROOT="/opt/sovereign-owner-managed"
WORKSPACE_HOST_ROOT="/opt/sovereign-agent-workspaces"
WORKSPACE_CONTAINER_ROOT="/var/lib/sovereign-agent/workspaces"
WORKSPACE_UID="10001"
WORKSPACE_GID="10001"
BROKER_SOCKET="${SOVEREIGN_MCP_BROKER_SOCKET:-/run/sovereign-chatgpt-broker/operator.sock}"
BROKER_RUNTIME_DIR="$(dirname "$BROKER_SOCKET")"
BROKER_GID=""
TRAEFIK_DOCKER_NETWORK="${SOVEREIGN_TRAEFIK_DOCKER_NETWORK:-traefik-public}"
COMPOSE_TEMPLATE="${SOVEREIGN_BACKEND_COMPOSE_TEMPLATE:-/opt/sovereign-chatgpt-tools/templates/sovereign-backend/docker-compose.yml}"
COMPOSE_PROJECT_DIR="/opt/sovereign-backend"
COMPOSE_FILE="$COMPOSE_PROJECT_DIR/docker-compose.yml"
COMPOSE_RUNTIME_ENV="$COMPOSE_PROJECT_DIR/compose-runtime.env"

fail() {
  printf 'rollback blocked: %s\n' "$*" >&2
  exit 1
}

[[ "$DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]] || fail "invalid image digest"
[[ -n "$IMAGE_REPOSITORY" ]] || fail "SOVEREIGN_BACKEND_IMAGE_REPOSITORY is missing"
[[ "$TRAEFIK_DOCKER_NETWORK" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ ]] \
  || fail "Traefik Docker network name is invalid"
ENV_FILE_ALLOWED=false
for allowed in "${ALLOWED_BACKEND_ENV_PATHS[@]}"; do
  if [[ "$ENV_FILE" == "$allowed" ]]; then
    ENV_FILE_ALLOWED=true
    break
  fi
done
[[ "$ENV_FILE_ALLOWED" == "true" && -f "$ENV_FILE" ]] \
  || fail "backend env file is missing or outside the allowlist"
MANAGED_ENV_ALLOWED=false
for allowed in "${ALLOWED_BACKEND_MANAGED_ENV_PATHS[@]}"; do
  if [[ "$MANAGED_ENV_FILE" == "$allowed" ]]; then
    MANAGED_ENV_ALLOWED=true
    break
  fi
done
[[ "$MANAGED_ENV_ALLOWED" == "true" && -f "$MANAGED_ENV_FILE" && ! -L "$MANAGED_ENV_FILE" ]] \
  || fail "backend managed env file is missing or outside the allowlist"
unset ENV_FILE_ALLOWED MANAGED_ENV_ALLOWED allowed
[[ -f "$COMPOSE_TEMPLATE" && ! -L "$COMPOSE_TEMPLATE" ]] \
  || fail "backend compose template is missing or invalid"
docker compose version >/dev/null 2>&1 || fail "docker compose plugin is unavailable"
if [[ -e "$COMPOSE_PROJECT_DIR" || -L "$COMPOSE_PROJECT_DIR" ]]; then
  [[ -d "$COMPOSE_PROJECT_DIR" && ! -L "$COMPOSE_PROJECT_DIR" ]] \
    || fail "backend compose project root is invalid"
else
  install -d -m 0750 "$COMPOSE_PROJECT_DIR"
fi
chmod 0750 "$COMPOSE_PROJECT_DIR"
umask 077
if [[ -e "$OWNER_INPUT_HOST_ROOT" || -L "$OWNER_INPUT_HOST_ROOT" ]]; then
  [[ -d "$OWNER_INPUT_HOST_ROOT" && ! -L "$OWNER_INPUT_HOST_ROOT" ]] \
    || fail "owner input host root is not a regular directory"
else
  mkdir -p "$OWNER_INPUT_HOST_ROOT"
fi
chmod 0700 "$OWNER_INPUT_HOST_ROOT"
[[ -w "$OWNER_INPUT_HOST_ROOT" && -x "$OWNER_INPUT_HOST_ROOT" ]] \
  || fail "owner input host root is not writable and searchable"
if [[ -e "$WORKSPACE_HOST_ROOT" || -L "$WORKSPACE_HOST_ROOT" ]]; then
  [[ -d "$WORKSPACE_HOST_ROOT" && ! -L "$WORKSPACE_HOST_ROOT" ]] \
    || fail "workspace host root is not a regular directory"
else
  mkdir -p "$WORKSPACE_HOST_ROOT"
fi
chown "$WORKSPACE_UID:$WORKSPACE_GID" "$WORKSPACE_HOST_ROOT"
chmod 0770 "$WORKSPACE_HOST_ROOT"
[[ -w "$WORKSPACE_HOST_ROOT" && -x "$WORKSPACE_HOST_ROOT" ]] \
  || fail "workspace host root is not writable and searchable"
[[ -S "$BROKER_SOCKET" ]] || fail "authoritative MCP broker socket is missing"
BROKER_GID="$(stat -c '%g' "$BROKER_SOCKET")"
[[ "$BROKER_GID" =~ ^[0-9]+$ ]] || fail "authoritative MCP broker group could not be resolved"

TARGET_IMAGE="${IMAGE_REPOSITORY}@${DIGEST}"
docker pull "$TARGET_IMAGE" >/dev/null
ACTUAL_DIGEST="$(docker image inspect --format '{{index .RepoDigests 0}}' "$TARGET_IMAGE" 2>/dev/null || true)"
[[ "$ACTUAL_DIGEST" == *"@$DIGEST" ]] || fail "pulled image digest does not match"
REVISION="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$TARGET_IMAGE" 2>/dev/null || true)"
[[ "$REVISION" =~ ^[0-9a-f]{40}$ ]] || fail "target image has no valid revision label"

# The restored backend must return to Traefik's actual shared bridge. Otherwise
# a healthy rollback container is invisible to the Docker provider.
for network in supabase_default areloria_arelorian-network sovereign-private "$TRAEFIK_DOCKER_NETWORK"; do
  docker network inspect "$network" >/dev/null 2>&1 || fail "required docker network missing: $network"
done

write_backend_compose_runtime() {
  local env_tmp=""
  local compose_tmp=""

  env_tmp="$(mktemp "$COMPOSE_PROJECT_DIR/.compose-runtime.env.XXXXXX")"
  {
    printf 'SOVEREIGN_BACKEND_IMAGE=%s\n' "$TARGET_IMAGE"
    printf 'SOVEREIGN_BACKEND_IMAGE_DIGEST=%s\n' "$DIGEST"
    printf 'SOVEREIGN_BACKEND_SOURCE_REVISION=%s\n' "$REVISION"
    printf 'SOVEREIGN_BACKEND_ENV_FILE=%s\n' "$ENV_FILE"
    printf 'SOVEREIGN_BACKEND_MANAGED_ENV_FILE=%s\n' "$MANAGED_ENV_FILE"
    printf 'SOVEREIGN_MCP_BROKER_GID=%s\n' "$BROKER_GID"
    printf 'SOVEREIGN_TRAEFIK_DOCKER_NETWORK=%s\n' "$TRAEFIK_DOCKER_NETWORK"
  } > "$env_tmp"
  chmod 0600 "$env_tmp"
  mv -f "$env_tmp" "$COMPOSE_RUNTIME_ENV"

  compose_tmp="$(mktemp "$COMPOSE_PROJECT_DIR/.docker-compose.yml.XXXXXX")"
  install -m 0640 "$COMPOSE_TEMPLATE" "$compose_tmp"
  mv -f "$compose_tmp" "$COMPOSE_FILE"
}

compose_backend() {
  env \
    -u SOVEREIGN_BACKEND_IMAGE \
    -u SOVEREIGN_BACKEND_IMAGE_DIGEST \
    -u SOVEREIGN_BACKEND_SOURCE_REVISION \
    -u SOVEREIGN_BACKEND_ENV_FILE \
    -u SOVEREIGN_BACKEND_MANAGED_ENV_FILE \
    -u SOVEREIGN_MCP_BROKER_GID \
    -u SOVEREIGN_TRAEFIK_DOCKER_NETWORK \
    docker compose \
      --project-name sovereign-backend \
      --project-directory "$COMPOSE_PROJECT_DIR" \
      --env-file "$COMPOSE_RUNTIME_ENV" \
      --file "$COMPOSE_FILE" \
      "$@"
}

docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
write_backend_compose_runtime
compose_backend config --quiet
compose_backend up -d --remove-orphans

HEALTH=""
for attempt in $(seq 1 12); do
  HEALTH="$(python3 -c 'import urllib.request; print(urllib.request.urlopen("http://127.0.0.1:8788/health/live", timeout=4).read().decode())' 2>/dev/null || true)"
  if printf '%s' "$HEALTH" | grep -q '"ok"[[:space:]]*:[[:space:]]*true'; then
    break
  fi
  sleep 5
done

if ! printf '%s' "$HEALTH" | grep -q '"ok"[[:space:]]*:[[:space:]]*true'; then
  docker logs "$CONTAINER" --tail 150 >&2 || true
  fail "rollback target failed health check"
fi

PUBLIC_OWNER_INGRESS=""
for attempt in $(seq 1 12); do
  PUBLIC_OWNER_INGRESS="$(python3 - <<'PY'
import hashlib
import json
import urllib.request

url = "https://sovereign-backend.arelorian.de/owner-approvals"
try:
    with urllib.request.urlopen(url, timeout=8) as response:
        body = response.read(512_000)
        ok = (
            int(response.status) == 200
            and b"<title>Sovereign Owner-Freigaben</title>" in body
        )
        payload = {
            "ok": ok,
            "status": "PUBLIC_OWNER_INGRESS_VERIFIED" if ok else "PUBLIC_OWNER_INGRESS_CONTRADICTED",
            "httpStatus": int(response.status),
            "responseSha256": hashlib.sha256(body).hexdigest(),
            "markerVerified": b"<title>Sovereign Owner-Freigaben</title>" in body,
            "secretValuesReturned": False,
        }
except Exception as exc:
    payload = {
        "ok": False,
        "status": "PUBLIC_OWNER_INGRESS_UNAVAILABLE",
        "errorType": type(exc).__name__,
        "secretValuesReturned": False,
    }
print(json.dumps(payload, sort_keys=True, separators=(",", ":")))
PY
)"
  if printf '%s' "$PUBLIC_OWNER_INGRESS" | grep -q '"ok":true'; then
    break
  fi
  sleep 5
done
if ! printf '%s' "$PUBLIC_OWNER_INGRESS" | grep -q '"ok":true'; then
  fail "rollback target failed public Traefik owner-approval ingress check"
fi

printf '{"ok":true,"container":"%s","image":"%s","revision":"%s","health":%s,"publicIngress":%s}\n' \
  "$CONTAINER" "$TARGET_IMAGE" "$REVISION" "$HEALTH" "$PUBLIC_OWNER_INGRESS"
