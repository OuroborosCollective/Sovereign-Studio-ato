{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-studio.local/contracts/operator_command_request.v1.schema.json",
  "title": "OperatorCommandRequestV1",
  "description": "Strict request emitted by the (optional, removable) NocoDB operator projection. A request never carries execution authority; the command gateway binds owner/principal server-side and routes the effect through the canonical #1113/#1118/#1119/#1120/#1100 boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorProjectionRevision",
    "sourceReceiptHashes",
    "requestedCapabilityId",
    "targetResourceId",
    "expectedBaseHash",
    "normalizedParameters",
    "requestedEffectClass",
    "reasonCode"
  ],
  "properties": {
    "schemaVersion": { "const": "operator-command-request.v1" },
    "operatorProjectionRevision": { "$ref": "#/$defs/boundRevision" },
    "sourceReceiptHashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/boundHash" }
    },
    "requestedCapabilityId": { "$ref": "#/$defs/safeToken" },
    "targetResourceId": { "$ref": "#/$defs/safeToken" },
    "expectedBaseHash": { "$ref": "#/$defs/boundHash" },
    "normalizedParameters": { "$ref": "#/$defs/parameters" },
    "requestedEffectClass": { "enum": ["INSPECT", "BOUNDED_MUTATION"] },
    "reasonCode": { "type": "string", "minLength": 1, "maxLength": 4000 }
  },
  "allOf": [
    {
      "if": { "properties": { "requestedEffectClass": { "const": "BOUNDED_MUTATION" } } },
      "then": {
        "required": ["sourceReceiptHashes", "expectedBaseHash"],
        "properties": {
          "sourceReceiptHashes": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "boundRevision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64}|sha256:[0-9a-f]{64})$"
    },
    "boundHash": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64}|sha256:[0-9a-f]{64})$"
    },
    "safeToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$"
    },
    "parameters": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    }
  }
}
