)

canonical = Path('docs/sovereign-continuity/LEDGER.jsonl')
runtime = Path('tools/sovereign-chatgpt-mcp/continuity-data/LEDGER.jsonl')
canonical_bytes = canonical.read_bytes()
runtime_bytes = runtime.read_bytes()
if canonical_bytes != runtime_bytes:
    raise SystemExit('continuity mirrors differ before append')
entry_id = 'continuity-repository-intelligence-evidence-lane-20260803'
if entry_id.encode('utf-8') in canonical_bytes:
    raise SystemExit('continuity entry already exists unexpectedly')
changed_paths = [
    '.github/workflows/sovereign-chatgpt-mcp.yml',
    'docs/architecture/REPOSITORY_INTELLIGENCE_EVIDENCE_LANE.v1.md',
    'docs/sovereign-continuity/LEDGER.jsonl',
    'tools/sovereign-chatgpt-mcp/Dockerfile',
    'tools/sovereign-chatgpt-mcp/continuity-data/LEDGER.jsonl',
    'tools/sovereign-chatgpt-mcp/deploy/install-on-vps.sh',
    'tools/sovereign-chatgpt-mcp/launcher.py',
    'tools/sovereign-chatgpt-mcp/repository_intelligence_tools.py',
    'tools/sovereign-chatgpt-mcp/tests/test_repository_intelligence_tools.py',
]
entry = {
    'schemaVersion': 'sovereign.continuity-ledger-entry.v1',
    'entryId': entry_id,
    'recordedAt': datetime.now(ZoneInfo('Europe/Berlin')).isoformat(timespec='seconds'),
    'sourceRevision': BASE_SHA,
    'mission': 'Die rechtlich sauberen Architekturprinzipien aus der statischen Priset- und Cloud-Code-Untersuchung als revisionsgebundene Repository-Intelligence- und Evidence-Lane in Sovereign Studio ATO integrieren.',
    'summary': 'Eine eigenständige, providerfreie Lane ergänzt das vorhandene Architektur-Radar um Git-private FTS5-Suche, deterministische lokale Projektion, Capability-Scopes, hashgebundene Patch- und Restore-Aktionen, Toolchain- und Schema-Evidence, Deployment-Sessions, Ressourcen-Graph und Kontext-Drift-Readback.',
    'decisions': [
        'Die bestehende Architektur-Sensorik wird erweitert und nicht durch einen parallelen Wahrheitspfad ersetzt.',
        'FTS5 und die deterministische lokale Token-Projektion bleiben Git-private Side-Channels; kanonisch sind Repository-SHA, Git-Blob und Dateihash.',
        'Mutierende Dateiaktionen benötigen exakte Repository- und Blob-Identitäten sowie einen revisionsgebundenen Capability-Scope; das Operating Profile bleibt zusätzlich fail-closed.',
        'Es werden keine proprietären Priset- oder Google-Binärteile, eingebetteten Schlüssel, Telemetriepfade, direkten Gemini/OpenAI/Anthropic-Routen oder LiteLLM-Flächen übernommen.',
