{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.studio/schemas/mutation-conflict.v1.schema.json",
  "title": "Mutation Conflict",
  "description": "Structured conflict information when a CAS check fails",
  "type": "object",
  "required": [
    "code",
    "message",
    "timestamp"
  ],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "BASE_STATE_STALE",
        "HEAD_MOVED",
        "OVERLAPPING_CHANGE",
        "RESOURCE_LOCKED",
        "LOCK_SCOPE_MISMATCH",
        "CONFIG_FINGERPRINT_CHANGED",
        "PERMISSION_BASE_MISMATCH",
        "DUPLICATE_EFFECT_DETECTED",
        "MUTATED_UNRECEIPTED_BLOCKED",
        "IDEMPOTENCY_REPLAY_MISMATCH"
      ],
      "description": "Machine-readable conflict code"
    },
    "message": {
      "type": "string",
      "maxLength": 500,
      "description": "Human-readable conflict description"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of conflict detection"
    },
    "expected_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$",
      "description": "Expected content hash (from base state)"
    },
    "actual_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$",
      "description": "Actual content hash (current head state)"
    },
    "conflict_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fields that have overlapping changes"
    },
    "lock_ref": {
      "type": ["string", "null"],
      "description": "Reference to blocking lock if RESOURCE_LOCKED"
    },
    "receipt_ref": {
      "type": ["string", "null"],
      "description": "Reference to existing receipt if applicable"
    },
    "allowed_next_step": {
      "type": ["string", "null"],
      "enum": [
        "retry_after_unlock",
        "rebase_and_retry",
        "manual_merge_required",
        "request_fresh_permission",
        "block"
      ],
      "description": "Recommended next action for the client"
    },
    "resource": {
      "type": ["object", "null"],
      "properties": {
        "resource_type": {
          "type": "string"
        },
        "resource_id": {
          "type": "string"
        },
        "owner_id": {
          "type": "string"
        }
      },
      "description": "Resource context of the conflict"
    },
    "base_state": {
      "type": ["object", "null"],
      "properties": {
        "version": {
          "type": "string"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "description": "Base state that was used for the mutation"
    },
    "head_state": {
      "type": ["object", "null"],
      "properties": {
        "version": {
          "type": "string"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "description": "Current head state that conflicted"
    }
  },
  "additionalProperties": false
}
