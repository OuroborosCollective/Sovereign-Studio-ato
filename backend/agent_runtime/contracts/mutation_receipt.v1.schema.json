{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.studio/schemas/mutation-receipt.v1.schema.json",
  "title": "Mutation Receipt",
  "description": "Canonical receipt binding mutation intent to outcome in append-only structure",
  "type": "object",
  "required": [
    "schema_version",
    "mutation_id",
    "idempotency_key",
    "resource_type",
    "resource_id",
    "owner_id",
    "capability_id",
    "base_version",
    "base_content_hash",
    "payload_hash",
    "permission_receipt_hash",
    "phase",
    "outcome",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "sovereign.mutation-receipt.v1",
      "description": "Schema version identifier"
    },
    "mutation_id": {
      "type": "string",
      "pattern": "^[^\\s/]{1,120}$",
      "description": "Unique identifier for this mutation"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,240}$",
      "description": "Client-provided idempotency key"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "agent_config",
        "capability_manifest",
        "tool_assignment",
        "policy_set",
        "integration_plan_state",
        "github_issue",
        "github_pr_metadata",
        "repository_branch",
        "appdeploy_snapshot",
        "deployment_target",
        "database_migration_ownership"
      ],
      "description": "Type of resource being mutated"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[^\\s/]{1,120}$",
      "description": "Unique identifier of the resource"
    },
    "owner_id": {
      "type": "string",
      "pattern": "^[^\\s/]{1,120}$",
      "description": "Owner of the resource"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[^\\s/]{1,120}$",
      "description": "ID of the capability authorizing this mutation"
    },
    "base_version": {
      "type": "string",
      "pattern": "^[^\\s]{1,120}$",
      "description": "Version of the resource that was read as base"
    },
    "base_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 hash of the base state content"
    },
    "head_version": {
      "type": ["string", "null"],
      "pattern": "^[^\\s]{1,120}$",
      "description": "Version at time of mutation application"
    },
    "head_content_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$",
      "description": "Content hash at time of mutation application"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 hash of the canonical mutation payload"
    },
    "permission_receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash of the authorizing permission receipt"
    },
    "phase": {
      "type": "string",
      "enum": [
        "prepared",
        "locked",
        "applied_unverified",
        "verified",
        "conflicted",
        "blocked",
        "invalidated"
      ],
      "description": "Current phase of the mutation lifecycle"
    },
    "outcome": {
      "type": "string",
      "pattern": "^[^\\s]{1,40}$",
      "description": "Outcome of the mutation"
    },
    "effect_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash of the expected effect for verification"
    },
    "previous_receipt_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash of the previous receipt in the chain"
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Canonical SHA-256 hash of this receipt"
    }
  },
  "additionalProperties": false
}
