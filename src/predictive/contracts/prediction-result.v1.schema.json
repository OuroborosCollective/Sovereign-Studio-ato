{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "prediction-result.v1",
  "title": "Prediction Result",
  "description": "Top-down prediction generated by the predictive layer. Represents the system's expectation of what the bottom-up signal should be.",
  "type": "object",
  "required": ["schemaVersion", "id", "predictedValue", "confidence", "node", "timestamp", "traceId"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "prediction-result.v1",
      "description": "Schema version identifier"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Unique identifier for this prediction"
    },
    "predictedValue": {
      "type": "number",
      "description": "The predicted value x̂(t)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score [0, 1] based on pattern match quality"
    },
    "node": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "The node this prediction is for"
    },
    "timestamp": {
      "type": "number",
      "minimum": 1000000000000,
      "maximum": 9000000000000,
      "description": "Unix timestamp in milliseconds"
    },
    "traceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Trace context for debugging"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Git SHA-1 revision at prediction generation"
    },
    "predictionHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 hash of the prediction content"
    },
    "patternId": {
      "type": "string",
      "description": "Reference to the pattern used for prediction"
    },
    "embedding": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 1,
      "maxItems": 16384,
      "description": "The latent space embedding used for this prediction"
    }
  }
}
