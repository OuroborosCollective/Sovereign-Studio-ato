{
	"appId": "com.arestudio.nocode.aab",
	"appName": "NOCode Studio",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"android": {
		"backgroundColor": "#f4f4f4",
		"allowMixedContent": false,
		"captureInput": true
	},
	"plugins": {
		"GoogleAuth": {
			"scopes": [
				"profile",
				"email"
			],
			"forceCodeForRefreshToken": false,
			"clientId": "511695074775-s08le2ju1k4nl2vv3i150i6tn084b682.apps.googleusercontent.com",
			"androidClientId": "511695074775-tjlbufo0r0co0eg8rsfonma9dnnv72hl.apps.googleusercontent.com",
			"serverClientId": "511695074775-s08le2ju1k4nl2vv3i150i6tn084b682.apps.googleusercontent.com"
		},
		"SplashScreen": {
			"launchShowDuration": 1500,
			"showSpinner": true,
			"backgroundColor": "#f4f4f4",
			"androidScaleType": "CENTER_CROP",
			"splashFullScreen": true,
			"splashImmersive": true,
			"useDialog": false
		}
	}
}
